<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="010-create-comment-like" author="Cristofer Lozano">
    <createTable tableName="comment_like">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="target_type" type="VARCHAR(20)" remarks="anime_comment | episode_comment">
        <constraints nullable="false"/>
      </column>
      <column name="target_id" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      constraintName="fk_comment_like_user"
      baseTableName="comment_like"
      baseColumnNames="user_id"
      referencedTableName="user"
      referencedColumnNames="id"/>

    <addUniqueConstraint
      constraintName="uq_comment_like_user_target"
      tableName="comment_like"
      columnNames="user_id, target_type, target_id"/>
  </changeSet>

</databaseChangeLog>
