<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="003-create-anime" author="Cristofer Lozano">
    <createTable tableName="anime">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="title" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="synopsis" type="TEXT"/>
      <column name="status" type="VARCHAR(20)" remarks="airing | finished | upcoming | cancelled | hiatus">
        <constraints nullable="false"/>
      </column>
      <column name="year" type="SMALLINT"/>
      <column name="cover_url" type="VARCHAR(500)"/>
      <column name="avg_score" type="DECIMAL(7,5)" defaultValueNumeric="0"/>
      <column name="ratings_count" type="INT" defaultValueNumeric="0"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
