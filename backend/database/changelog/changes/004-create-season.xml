<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="004-create-season" author="Cristofer Lozano">
    <createTable tableName="season">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="anime_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="number" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="title" type="VARCHAR(255)"/>
      <column name="year" type="SMALLINT"/>
      <column name="avg_score" type="DECIMAL(7,5)" defaultValueNumeric="0"/>
      <column name="ratings_count" type="INT" defaultValueNumeric="0"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      constraintName="fk_season_anime"
      baseTableName="season"
      baseColumnNames="anime_id"
      referencedTableName="anime"
      referencedColumnNames="id"/>

    <addUniqueConstraint
      constraintName="uq_season_anime_number"
      tableName="season"
      columnNames="anime_id, number"/>
  </changeSet>

</databaseChangeLog>
