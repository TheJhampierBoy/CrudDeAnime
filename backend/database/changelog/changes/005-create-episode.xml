<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="005-create-episode" author="Cristofer Lozano">
    <createTable tableName="episode">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="season_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="number" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="title" type="VARCHAR(255)"/>
      <column name="synopsis" type="TEXT"/>
      <column name="aired_at" type="DATE"/>
      <column name="duration_sec" type="INT"/>
      <column name="avg_score" type="DECIMAL(7,5)" defaultValueNumeric="0"/>
      <column name="ratings_count" type="INT" defaultValueNumeric="0"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      constraintName="fk_episode_season"
      baseTableName="episode"
      baseColumnNames="season_id"
      referencedTableName="season"
      referencedColumnNames="id"/>

    <addUniqueConstraint
      constraintName="uq_episode_season_number"
      tableName="episode"
      columnNames="season_id, number"/>
  </changeSet>

</databaseChangeLog>
