<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="007-create-episode-rating" author="Cristofer Lozano">
    <createTable tableName="episode_rating">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="episode_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="user_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="score_story" type="DECIMAL(7,5)">
        <constraints nullable="false"/>
      </column>
      <column name="score_animation" type="DECIMAL(7,5)">
        <constraints nullable="false"/>
      </column>
      <column name="score_music" type="DECIMAL(7,5)">
        <constraints nullable="false"/>
      </column>
      <column name="score_characters" type="DECIMAL(7,5)">
        <constraints nullable="false"/>
      </column>
      <column name="final_score" type="DECIMAL(7,5)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      constraintName="fk_episode_rating_episode"
      baseTableName="episode_rating"
      baseColumnNames="episode_id"
      referencedTableName="episode"
      referencedColumnNames="id"/>

    <addForeignKeyConstraint
      constraintName="fk_episode_rating_user"
      baseTableName="episode_rating"
      baseColumnNames="user_id"
      referencedTableName="user"
      referencedColumnNames="id"/>

    <addUniqueConstraint
      constraintName="uq_episode_rating_user"
      tableName="episode_rating"
      columnNames="episode_id, user_id"/>
  </changeSet>

</databaseChangeLog>
