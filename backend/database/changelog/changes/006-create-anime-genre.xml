<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="006-create-anime-genre" author="Cristofer Lozano">
    <createTable tableName="anime_genre">
      <column name="anime_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="genre_id" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      constraintName="pk_anime_genre"
      tableName="anime_genre"
      columnNames="anime_id, genre_id"/>

    <addForeignKeyConstraint
      constraintName="fk_anime_genre_anime"
      baseTableName="anime_genre"
      baseColumnNames="anime_id"
      referencedTableName="anime"
      referencedColumnNames="id"/>

    <addForeignKeyConstraint
      constraintName="fk_anime_genre_genre"
      baseTableName="anime_genre"
      baseColumnNames="genre_id"
      referencedTableName="genre"
      referencedColumnNames="id"/>
  </changeSet>

</databaseChangeLog>
